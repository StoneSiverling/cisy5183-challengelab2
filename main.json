{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": { "type": "string" },
    "alias": { "type": "string" },
    "adminUsername": { "type": "string", "defaultValue": "azureuser" },
    "sshPublicKey": { "type": "string", "metadata": { "description": "Paste your SSH public key (ssh-rsa ...)" } },
    "vmSize": { "type": "string", "defaultValue": "Standard_B1s" },
    "vnetCidr": { "type": "string", "defaultValue": "10.20.0.0/16" },
    "webSubnetCidr": { "type": "string", "defaultValue": "10.20.10.0/24" },
    "dataSubnetCidr": { "type": "string", "defaultValue": "10.20.20.0/24" }
  },
  "variables": {
    "vnetName": "[format('vnet-core-{0}', parameters('alias'))]",
    "snetWeb": "snet-web",
    "snetData": "snet-data",
    "vmWebName": "[format('vm-web-{0}', parameters('alias'))]",
    "vmDataName": "[format('vm-data-{0}', parameters('alias'))]",
    "nicWebName": "[format('nic-web-{0}', parameters('alias'))]",
    "nicDataName": "[format('nic-data-{0}', parameters('alias'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-04-01",
      "name": "[variables('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": { "addressPrefixes": [ "[parameters('vnetCidr')]" ] },
        "subnets": [
          { "name": "[variables('snetWeb')]", "properties": { "addressPrefix": "[parameters('webSubnetCidr')]" } },
          { "name": "[variables('snetData')]", "properties": { "addressPrefix": "[parameters('dataSubnetCidr')]" } }
        ]
      },
      "tags": { "lab": "cisy5183", "challenge": "ch02" }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-04-01",
      "name": "[variables('nicWebName')]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('snetWeb'))]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": null
            }
          }
        ],
        "enableIPForwarding": false
      },
      "tags": { "role": "web", "lab": "cisy5183" }
    },
    {
      "type": "Microsoft.Network/networkInterfaces",
      "apiVersion": "2023-04-01",
      "name": "[variables('nicDataName')]",
      "location": "[parameters('location')]",
      "properties": {
        "ipConfigurations": [
          {
            "name": "ipconfig1",
            "properties": {
              "subnet": {
                "id": "[resourceId('Microsoft.Network/virtualNetworks/subnets', variables('vnetName'), variables('snetData'))]"
              },
              "privateIPAllocationMethod": "Dynamic",
              "publicIPAddress": null
            }
          }
        ],
        "enableIPForwarding": false
      },
      "tags": { "role": "data", "lab": "cisy5183" }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('vmWebName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicWebName'))]"
      ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "storageProfile": {
          "imageReference": { "publisher": "Canonical", "offer": "0001-com-ubuntu-server-jammy", "sku": "22_04-lts-gen2", "version": "latest" },
          "osDisk": { "createOption": "FromImage", "managedDisk": { "storageAccountType": "StandardSSD_LRS" } }
        },
        "osProfile": {
          "computerName": "[variables('vmWebName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": { "publicKeys": [ { "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]", "keyData": "[parameters('sshPublicKey')]" } ] }
          }
        },
        "networkProfile": {
          "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicWebName'))]" } ]
        }
      },
      "tags": { "role": "web", "lab": "cisy5183" }
    },
    {
      "type": "Microsoft.Compute/virtualMachines",
      "apiVersion": "2023-09-01",
      "name": "[variables('vmDataName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Network/networkInterfaces', variables('nicDataName'))]"
      ],
      "properties": {
        "hardwareProfile": { "vmSize": "[parameters('vmSize')]" },
        "storageProfile": {
          "imageReference": { "publisher": "Canonical", "offer": "0001-com-ubuntu-server-jammy", "sku": "22_04-lts-gen2", "version": "latest" },
          "osDisk": { "createOption": "FromImage", "managedDisk": { "storageAccountType": "StandardSSD_LRS" } }
        },
        "osProfile": {
          "computerName": "[variables('vmDataName')]",
          "adminUsername": "[parameters('adminUsername')]",
          "linuxConfiguration": {
            "disablePasswordAuthentication": true,
            "ssh": { "publicKeys": [ { "path": "[format('/home/{0}/.ssh/authorized_keys', parameters('adminUsername'))]", "keyData": "[parameters('sshPublicKey')]" } ] }
          }
        },
        "networkProfile": {
          "networkInterfaces": [ { "id": "[resourceId('Microsoft.Network/networkInterfaces', variables('nicDataName'))]" } ]
        }
      },
      "tags": { "role": "data", "lab": "cisy5183" }
    }
  ],
  "outputs": {
    "vnetName": { "type": "string", "value": "[variables('vnetName')]" }
  }
}

